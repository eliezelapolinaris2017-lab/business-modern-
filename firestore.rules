rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function owner(userId) { return signed() && request.auth.uid == userId; }
    function admin() { return signed() && request.auth.token.email == "nexustoolspr@gmail.com"; }
    function protectedPlanKeys() { return ['plan','planStatus','stripeCustomerId','stripeSubscriptionId','planUpdatedAt','planExpiresAt','lastPaymentMethod','lastPaymentAmount','lastPaymentDate']; }
    function pendingRequestKeys() { return ['pendingPlan','pendingPlanName','pendingPaymentUrl','pendingPlanStatus','pendingPlanRequestedAt']; }
    function normalCollections() { return ['clients','services','quotes','followups','contracts','team','assets','suppliers','supplierPayments','payroll','payrollRetentions','purchases','invoices','payments','cashflow']; }

    function portalAccess(portal) {
      return portal.get('claimedBy', '') == '' || (signed() && (portal.claimedBy == request.auth.uid || portal.ownerId == request.auth.uid));
    }
    function verifiedPortalIdentity(portal) {
      return signed() && request.auth.token.email_verified == true
        && request.auth.token.get('phone_number', '') != ''
        && portal.get('identityPhone', '') == request.auth.token.phone_number
        && (portal.get('identityEmail', '') == '' || portal.identityEmail == request.auth.token.email.lower())
        && portal.enabled == true && portal.client.id is string
        && portalAccess(portal);
    }
    match /clientAccounts/{accountId} {
      allow get: if owner(accountId);
      allow create: if owner(accountId)
        && request.resource.data.keys().hasOnly(['portalToken','ownerId','clientId','createdAt'])
        && request.resource.data.createdAt == request.time
        && verifiedPortalIdentity(get(/databases/$(database)/documents/clientPortals/$(request.resource.data.portalToken)).data)
        && request.resource.data.ownerId == get(/databases/$(database)/documents/clientPortals/$(request.resource.data.portalToken)).data.ownerId
        && request.resource.data.clientId == get(/databases/$(database)/documents/clientPortals/$(request.resource.data.portalToken)).data.client.id
        && getAfter(/databases/$(database)/documents/clientPortals/$(request.resource.data.portalToken)).data.claimedBy == request.auth.uid;
    }

    function validDecision(userId, quoteId, decision) {
      let portal = get(/databases/$(database)/documents/clientPortals/$(decision.portalToken)).data;
      let quote = get(/databases/$(database)/documents/users/$(userId)/quotes/$(quoteId)).data;
      return portalAccess(portal) && portal.enabled == true && portal.ownerId == userId
        && quoteId in portal.quoteRevisions
        && portal.quoteRevisions[quoteId] == quote.get('updatedAt', null)
        && portal.quoteExpires[quoteId] >= request.time
        && !(quote.get('status', '') in ['Aprobada','Rechazada','Convertida','Cancelada','Vencida'])
        && quote.get('convertedInvoiceId', '') == '' && quote.get('convertedServiceId', '') == ''
        && decision.keys().hasOnly(['status','name','signature','reason','at','portalToken'])
        && decision.status in ['Aprobada','Rechazada']
        && decision.name is string && decision.name.size() > 0 && decision.name.size() <= 120
        && decision.reason is string && decision.reason.size() <= 1000
        && decision.signature is string && decision.signature.size() <= 200000
        && ((decision.status == 'Rechazada' && decision.signature == '') || (decision.signature.matches('data:image/png;base64,.*') && decision.signature.size() > 100))
        && decision.at == request.time;
    }
    match /users/{userId}/quotes/{quoteId} {
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','clientDecision','updatedAt'])
        && validDecision(userId, quoteId, request.resource.data.clientDecision)
        && request.resource.data.status == request.resource.data.clientDecision.status
        && request.resource.data.updatedAt == request.time
        && !exists(/databases/$(database)/documents/clientPortals/$(request.resource.data.clientDecision.portalToken)/responses/$(quoteId))
        && getAfter(/databases/$(database)/documents/clientPortals/$(request.resource.data.clientDecision.portalToken)/responses/$(quoteId)).data == request.resource.data.clientDecision;
    }

    match /users/{userId} {
      allow create: if owner(userId);
      allow read: if owner(userId) || admin();
      allow update: if admin()
        || (owner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedPlanKeys())
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(pendingRequestKeys())
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(pendingRequestKeys())
              && request.resource.data.pendingPlanStatus == 'pending'
            )
          )
        );
      allow delete: if admin();

      match /planRequests/{requestId} {
        allow create: if owner(userId)
          && request.resource.data.status == 'pending'
          && request.resource.data.uid == userId;
        allow read: if owner(userId) || admin();
        allow update, delete: if admin();
      }

      match /{collectionId}/{documentId} {
        allow read, write: if (owner(userId) || admin()) && collectionId in normalCollections();
      }
    }

    match /clientPortals/{portalId} {
      allow get: if portalAccess(resource.data);
      allow create: if signed() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signed() && resource.data.ownerId == request.auth.uid;
      allow update: if verifiedPortalIdentity(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy'])
        && request.resource.data.claimedBy == request.auth.uid
        && !exists(/databases/$(database)/documents/clientAccounts/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/clientAccounts/$(request.auth.uid)).data.portalToken == portalId;
    }

    match /clientPortals/{portalId}/responses/{quoteId} {
      allow get: if portalAccess(get(/databases/$(database)/documents/clientPortals/$(portalId)).data);
      allow create: if request.resource.data.portalToken == portalId
        && validDecision(get(/databases/$(database)/documents/clientPortals/$(portalId)).data.ownerId, quoteId, request.resource.data)
        && getAfter(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/clientPortals/$(portalId)).data.ownerId)/quotes/$(quoteId)).data.clientDecision == request.resource.data;
    }

    match /{path=**}/planRequests/{requestId} {
      allow read: if admin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
